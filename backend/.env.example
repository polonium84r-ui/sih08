# =========================================================================
# RailFlow Backend Environment Configuration Template
# =========================================================================

# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# Allowed CORS Origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# RailRadar Real-Time Train Telemetry API Key
# Obtain token from: https://railradar.in/dashboard
RAILRADAR_API_KEY=your_railradar_api_token_here

# RailRadar API Endpoint
RAILRADAR_API_BASE_URL=https://api.railradar.in/v1

# PostgreSQL Database Connection (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/railflow_db?schema=public"
